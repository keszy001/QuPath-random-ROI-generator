\outl0\strokewidth0 \strokec2 import qupath.lib.objects.PathAnnotationObject\
import qupath.lib.roi.RoiTools\
\
def NUM_SQUARES = 20 // (varies by ROI size)\
def SQUARE_SIZE_UM = 250\
def MAX_API_ATTEMPTS = 100\
\
def selected = getSelectedObjects().findAll \{ it.isAnnotation() \}\
def regionROI = selected[0].getROI()\
\
def pixelWidth = getCurrentServer().getPixelCalibration().getPixelWidth()\
def pxSize = SQUARE_SIZE_UM / pixelWidth\
\
def annotations = []\
def placedROIs = [] \
\
for (int i = 0; i < NUM_SQUARES; i++) \{\
    def roi = RoiTools.createRandomRectangle(regionROI, pxSize, pxSize, MAX_API_ATTEMPTS, false, null)\
\
    if (roi != null) \{\
        boolean overlap = false\
\
        // Correct overlap check using RoiTools.combineROIs\
        for (existing in placedROIs) \{\
            // Calculate intersection; if area > 0, they overlap\
            def intersection = RoiTools.combineROIs(roi, existing, RoiTools.CombineOp.INTERSECT)\
            if (!intersection.isEmpty()) \{\
                overlap = true\
                break\
            \}\
        \}\
\
        if (!overlap) \{\
            placedROIs.add(roi)\
            def ann = new PathAnnotationObject(roi)\
            ann.setName("Square $\{placedROIs.size()\}")\
            annotations.add(ann)\
        \}\
    \}\
\}\
\
addObjects(annotations)\
}